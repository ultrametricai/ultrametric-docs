    {
      "name": "status",
      "title": "Check connection status",
      "description": "Read the signed-in account, email verification, selected organization, and environment. Supply processId to check its release access and availability. Does not change the account, organization, or saved information.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri"
          },
          "environment": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "emailVerified": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "email",
              "emailVerified"
            ],
            "additionalProperties": false
          },
          "selectedOrganizationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "internalUser": {
            "type": "boolean"
          },
          "process": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "releaseAccess": {
                    "type": "boolean"
                  },
                  "available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "releaseAccess",
                  "available"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "origin",
          "environment",
          "user",
          "selectedOrganizationId",
          "internalUser",
          "process"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      }
    },
    {
      "name": "open_process",
      "title": "Open or resume a process",
      "description": "Start or resume a process for the selected organization and company. Returns instructions, current context, run ID, and next update key. Omit companyId only when the organization has zero or one company; get_context lists choices. Use period to distinguish recurring runs. Does not execute the process.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "companyId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "period": {
            "default": "",
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "processId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          }
        },
        "required": [
          "organizationId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      }
    },
    {
      "name": "save_update",
      "title": "Save process progress and records",
      "description": "Automatically save a meaningful progress update and optional profile, document, or vault reference. Copy organizationId, runId, and updateKey from the preceding result. Omit record IDs for new records; existing records require their current revision. Vault references are protected. Mark sensitive documents, profiles, and notes visibility=protected; protected access is checked separately. A delete record appends a tombstone. Text is recorded as reported, with no automatic fact extraction or external action. Profile review is reported evidence, not verified human approval. Retry an uncertain write with the same key and exact input. Do not store secret values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "runId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "updateKey": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "visibility": {
            "default": "organization",
            "type": "string",
            "enum": [
              "organization",
              "protected"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "source": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "progress": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "in_progress",
                  "waiting",
                  "completed",
                  "deleted"
                ]
              },
              "detail": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "records": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "profile"
                    },
                    "visibility": {
                      "default": "organization",
                      "type": "string",
                      "enum": [
                        "organization",
                        "protected"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "expectedRevision": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "profile": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "$ref": "#/$defs/__schema0"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "profile"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "document"
                    },
                    "visibility": {
                      "default": "organization",
                      "type": "string",
                      "enum": [
                        "organization",
                        "protected"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "expectedRevision": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "state": {
                      "default": "draft",
                      "type": "string",
                      "enum": [
                        "draft",
                        "current"
                      ]
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32000,
                      "pattern": "\\S"
                    },
                    "source": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 6000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "purpose",
                    "body"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "reference"
                    },
                    "visibility": {
                      "default": "protected",
                      "type": "string",
                      "const": "protected"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "expectedRevision": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "property": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 6000
                    },
                    "locationType": {
                      "type": "string",
                      "enum": [
                        "reference",
                        "hint"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 6000
                    }
                  },
                  "required": [
                    "kind",
                    "subject",
                    "property",
                    "provider",
                    "location",
                    "locationType",
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "delete"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "expectedRevision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "expectedRevision"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "organizationId",
          "runId",
          "updateKey",
          "text"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          }
        },
        "required": [
          "organizationId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
